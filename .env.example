# Copy to `.env` (git-ignored) and fill in. Every value can also be set as a real env var.

# --- Database (docker compose up -d db) ---------------------------------------------
DATABASE_URL=postgresql://koffito:koffito@localhost:5432/koffito

# --- Auth (ours) --------------------------------------------------------------------
# HMAC key for access tokens; at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# VERIFY_EMAIL_TTL_HOURS=24
# RESET_PASSWORD_TTL_MINUTES=60
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCKOUT_MINUTES=15
# Links in emails point here (the web app):
APP_BASE_URL=http://localhost:5173
# Where the browser sees the auth routes (the app reaches the API under /api):
# AUTH_COOKIE_PATH=/api/auth

# --- Email (Mailpit locally: inbox at http://localhost:8025) ------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
# MAIL_FROM=Koffito <no-reply@koffito.local>

# --- Rate limits (per user / per IP, per process) ----------------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_LIMIT=20         RATE_LIMIT_AUTH_WINDOW_SECONDS=300
# RATE_LIMIT_EMAIL_LIMIT=5         RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600
# RATE_LIMIT_READ_LIMIT=120        RATE_LIMIT_READ_WINDOW_SECONDS=60
# RATE_LIMIT_WRITE_LIMIT=30        RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# RATE_LIMIT_REPORT_LIMIT=5        RATE_LIMIT_REPORT_WINDOW_SECONDS=3600
# RATE_LIMIT_ADMIN_LIMIT=60        RATE_LIMIT_ADMIN_WINDOW_SECONDS=60

# --- Background jobs ----------------------------------------------------------------
# Run matchmaking / reminders / completion inside this process. Enable on exactly one
# instance, or leave off and run `python -m koffito.jobs all --loop` (compose `jobs`).
JOBS_ENABLED=false
# JOBS_INTERVAL_SECONDS=300

# --- Deployment ---------------------------------------------------------------------
# development | staging | production (production requires ENFORCE_HTTPS=true and TRUSTED_HOSTS)
ENVIRONMENT=development
ENFORCE_HTTPS=false
TRUSTED_HOSTS=*
# Only needed if the web app is served from a different origin than the API.
CORS_ORIGINS=
LOG_LEVEL=INFO
