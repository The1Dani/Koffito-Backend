# Copy to `.env` (git-ignored) and fill in. Every value can also be set as a real env var.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://gxdebgnkrstzxtlvcsix.supabase.co
# Publishable (or legacy anon) key. Public; the app ships the same one.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service-role (or `sb_secret_...`) key. Server only, used by background jobs. Never in the app.
SUPABASE_SERVICE_ROLE_KEY=
# Plaintext backend key: `select private.rotate_backend_key();` in the Supabase SQL editor.
# Sent as `X-Koffito-Backend-Key` on every Data API call; without it PostgREST refuses the request.
KOFFITO_BACKEND_KEY=

# --- JWT verification (defaults are right for Supabase) ----------------------
# JWT_AUDIENCE=authenticated
# JWT_LEEWAY_SECONDS=10
# JWKS_CACHE_TTL_SECONDS=3600
# JWKS_MIN_REFETCH_SECONDS=60
# SUPABASE_TIMEOUT_SECONDS=10

# --- Rate limits (per user, per process) --------------------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_READ_LIMIT=120        RATE_LIMIT_READ_WINDOW_SECONDS=60
# RATE_LIMIT_WRITE_LIMIT=30        RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# RATE_LIMIT_REPORT_LIMIT=5        RATE_LIMIT_REPORT_WINDOW_SECONDS=3600
# RATE_LIMIT_ADMIN_LIMIT=60        RATE_LIMIT_ADMIN_WINDOW_SECONDS=60

# --- Background jobs (needs SUPABASE_SERVICE_ROLE_KEY) ------------------------
# Run the reminder/matchmaking loop inside this process. Enable on exactly one instance,
# or leave off and run `python -m koffito.jobs all` from cron instead.
JOBS_ENABLED=false
# JOBS_INTERVAL_SECONDS=300

# --- Deployment ---------------------------------------------------------------
# development | staging | production (production requires ENFORCE_HTTPS=true and TRUSTED_HOSTS)
ENVIRONMENT=development
ENFORCE_HTTPS=false
# Comma-separated. Behind a TLS-terminating proxy, run uvicorn with --proxy-headers.
TRUSTED_HOSTS=*
CORS_ORIGINS=
LOG_LEVEL=INFO
